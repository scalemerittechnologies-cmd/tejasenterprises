# Copy these names into .env.local. Set your own private values; none are preset.
ADMIN_USERNAME=choose-a-private-admin-id
# Use at least 16 characters for the administrator password.
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Preferred for admin photo/content publishing: one GitHub commit triggers a hosting deploy.
# Use a fine-grained token with Contents: Read and write on this repository only.
GITHUB_CONTENT_OWNER=scalemerittechnologies-cmd
GITHUB_CONTENT_REPO=tejasenterprises
GITHUB_CONTENT_BRANCH=main
GITHUB_CONTENT_TOKEN=your-fine-grained-github-token

# Quote forms open WhatsApp directly. No lead, photo or content data is saved to a database.
